{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "url",
    "input_budget",
    "durability"
  ],
  "properties": {
    "url": {
      "type": "string",
      "minLength": 1,
      "writeOnly": true,
      "x-busbar-secret": true
    },
    "connect_timeout_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "input_budget": {
      "type": "integer",
      "minimum": 1,
      "description": "Per-instance input and descriptor allocation budget in bytes."
    },
    "durability": {
      "enum": [
        "local",
        "ephemeral"
      ],
      "description": "Local requires verified healthy AOF, appendfsync always and no fsync suppression. Ephemeral makes no crash-durable acknowledgement claim."
    }
  }
}
